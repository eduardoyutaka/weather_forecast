<% content_for :title, "#{@address.city}, #{@address.state} #{@address.postal_code} · Weather Forecast" %>

<h1><%= @address.city %>, <%= @address.state %> <%= @address.postal_code %></h1>

<div class="address-page">
  <dl class="address-details">
    <dt>City</dt><dd><%= @address.city %></dd>
    <dt>State</dt><dd><%= @address.state %></dd>
    <dt>Country</dt><dd><%= @address.country_code %></dd>
    <dt>ZIP code</dt><dd><%= @address.postal_code %></dd>
    <dt>Coordinates</dt><dd><%= @address.latitude %>, <%= @address.longitude %></dd>
  </dl>

  <%= turbo_frame_tag "forecast", src: address_forecast_path(@address), class: "forecast" do %>
    <p class="muted" aria-busy="true">Loading forecast…</p>
  <% end %>
</div>

<%= link_to "← New search", root_path %>
